# —— 必填：对话大脑（Claude）——
# 不填也能运行，但会进入「演示模式」，回复是固定的示例句子。
ANTHROPIC_API_KEY=

# 可选：换模型（默认 claude-opus-5-5）
# CLAUDE_MODEL=claude-opus-5-5

# —— 可选：克隆声音（ElevenLabs）——
# 不填时，App 会用设备自带的中文语音朗读。
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# —— 强烈建议：访问口令 ——
# 设置后，打开 App 需要输入用户名（任意）和这个口令。部署到公网前必须设置。
APP_PASSCODE=

PORT=3000
